export BITRIX24_WEBHOOK_URL="https://your-domain.bitrix24.ru/rest/USER_ID/WEBHOOK_CODE/"

# Optional: colon-separated directories with local git projects for activity scans.
# Examples:
# export PROJECTS_DIRS="$HOME/Projects"
# export PROJECTS_DIRS="$HOME/Projects:$HOME/work/clients"

# Optional: path to Google OAuth client credentials for google-workspace skill.
# Default used by the skill is .claude/google-oauth-client.json
# export GOOGLE_OAUTH_CLIENT_PATH="$PWD/.claude/google-oauth-client.json"
